from pathlib import Path
import argparse
import sys
import pandas as pd


def resolve_path(path_arg: str | None, default_name: str) -> Path:
    """Use explicit path if provided; otherwise look in the script folder."""
    if path_arg:
        return Path(path_arg).expanduser().resolve()
    return (Path(__file__).resolve().parent / default_name).resolve()


def load_morg(path: Path, year: int) -> pd.DataFrame:
    if not path.exists():
        sys.exit(f"ERROR: File not found: {path}")

    print(f"Loading {path} ...", flush=True)
    df = pd.read_csv(path, low_memory=False)
    df.columns = df.columns.str.lower().str.strip()

    # Standardize state variable
    if "state" not in df.columns and "stfips" in df.columns:
        df["state"] = df["stfips"]

    required_basic = ["hhid", "hhnum", "lineno", "intmonth", "minsamp", "sex", "race", "age"]
    missing = [c for c in required_basic if c not in df.columns]
    if missing:
        sys.exit(f"ERROR in {path.name}: missing required columns: {missing}")

    # Force consistent merge-key types
    for col in ["hhid", "hhnum", "lineno", "intmonth", "state"]:
        if col in df.columns:
            df[col] = df[col].astype(str).str.strip()

    # Numeric fields
    for col in ["minsamp", "sex", "race", "age"]:
        df[col] = pd.to_numeric(df[col], errors="coerce")

    df["year_file"] = year
    print(f"  {len(df):,} records loaded.")
    return df


def restrict_to_morg(df: pd.DataFrame) -> pd.DataFrame:
    before = len(df)
    df = df[df["minsamp"].isin([4, 8])].copy()
    print(f"  After minsamp filter: {len(df):,} (dropped {before - len(df):,})")
    return df


def build_rename_map(df: pd.DataFrame, suffix: str, merge_keys: list[str]) -> dict:
    rename = {}
    for col in df.columns:
        if col not in merge_keys and col not in ["minsamp", "year_file"]:
            rename[col] = f"{col}{suffix}"
    return rename


def create_panel(df08: pd.DataFrame, df09: pd.DataFrame) -> pd.DataFrame:
    merge_keys = ["hhid", "hhnum", "lineno", "intmonth", "state"]

    # Only MIS4 (year t) -> MIS8 (year t+1) is a real year-over-year link.
    # Under the CPS 4-8-4 rotation design, MIS8 is the outgoing group that
    # leaves the sample for good, so there's no household to find at MIS4
    # the following year (Madrian & Lefgren 1999, NBER TWP 247, Sec. II).
    # A prior version of this code also paired MIS8(t) with MIS4(t+1); those
    # "matches" were shown to be spurious (age at t+1 was often *lower* than
    # at t), so that branch has been removed.
    pairs = [
        (df08[df08["minsamp"] == 4].copy(), df09[df09["minsamp"] == 8].copy(), "MIS4_to_MIS8"),
    ]

    out = []
    for t_df, t1_df, label in pairs:
        t_df = t_df.rename(columns=build_rename_map(t_df, "_t", merge_keys))
        t1_df = t1_df.rename(columns=build_rename_map(t1_df, "_t1", merge_keys))

        merged = pd.merge(
            t_df,
            t1_df,
            on=merge_keys,
            how="inner",
        )
        merged["pair_type"] = label
        print(
            f"[{label}] naive merge: {len(merged):,} matched pairs "
            f"from {len(t_df):,} t-records and {len(t1_df):,} t+1-records."
        )
        out.append(merged)

    if not out:
        return pd.DataFrame()

    return pd.concat(out, ignore_index=True)


def apply_sra_filter(df: pd.DataFrame):
    # S|R|A criterion (Madrian & Lefgren 1999, NBER TWP 247, Sec. VII): a naive
    # HHID/HHNUM/LINENO match is invalidated if sex differs, race differs, or
    # age moved outside a plausible one-year range. We use their "less
    # restrictive" age band: valid merges have age_t1 - age_t in [-1, 3]
    # (accounts for birthday timing and some measurement error; a January
    # birthday interviewed just before/after the cutoff can show 0 or 2 years).
    needed = ["sex_t", "sex_t1", "race_t", "race_t1", "age_t", "age_t1"]
    missing = [c for c in needed if c not in df.columns]
    if missing:
        sys.exit(f"ERROR: Missing post-merge SRA columns: {missing}")

    sex_mismatch = df["sex_t"] != df["sex_t1"]
    race_mismatch = df["race_t"] != df["race_t1"]

    age_diff = df["age_t1"] - df["age_t"]
    age_mismatch = (age_diff < -1) | (age_diff > 3)

    invalid_mask = sex_mismatch | race_mismatch | age_mismatch

    valid = df.loc[~invalid_mask].copy()
    invalid = df.loc[invalid_mask].copy()

    invalid["flag_sex"] = sex_mismatch.loc[invalid_mask]
    invalid["flag_race"] = race_mismatch.loc[invalid_mask]
    invalid["flag_age"] = age_mismatch.loc[invalid_mask]

    return valid, invalid


def print_diagnostics(naive: pd.DataFrame, valid: pd.DataFrame, invalid: pd.DataFrame, n_t: int):
    naive_rate = (len(naive) / n_t * 100) if n_t else 0
    valid_rate = (len(valid) / n_t * 100) if n_t else 0
    reject_rate = (len(invalid) / len(naive) * 100) if len(naive) else 0

    print("\n" + "=" * 60)
    print("MERGE DIAGNOSTICS")
    print("=" * 60)
    print(f"Records in 2008 file        : {n_t:>10,}")
    print(f"Naive merged pairs         : {len(naive):>10,} ({naive_rate:.1f}%)")
    print(f"Rejected by S|R|A          : {len(invalid):>10,} ({reject_rate:.1f}% of naive)")
    print(f"Valid merged pairs         : {len(valid):>10,} ({valid_rate:.1f}%)")

    if len(invalid) > 0:
        print("\nBreakdown of rejected matches:")
        print(f"  Sex mismatch            : {invalid['flag_sex'].sum():>10,}")
        print(f"  Race mismatch           : {invalid['flag_race'].sum():>10,}")
        print(f"  Age outside [-1, 3]     : {invalid['flag_age'].sum():>10,}")

    print("=" * 60)


def main():
    parser = argparse.ArgumentParser(description="Merge CPS MORG 2008 and 2009.")
    parser.add_argument("--morg08", default=None, help="Path to 2008 MORG CSV")
    parser.add_argument("--morg09", default=None, help="Path to 2009 MORG CSV")
    parser.add_argument("--out", default="merged_morg_0809.csv", help="Output CSV")
    parser.add_argument("--keep-invalid", action="store_true", help="Save rejected matches")
    args = parser.parse_args()

    # Defaults if files are in same folder as script
    path08 = resolve_path(args.morg08, "/Users/vedikabaradwaj/pdi_pensions/data/csv/morg08.csv")
    path09 = resolve_path(args.morg09, "/Users/vedikabaradwaj/pdi_pensions/data/csv/morg09.csv")
    out_path = Path(args.out).expanduser().resolve()

    print("\nStep 1: Load data")
    df08 = load_morg(path08, 2008)
    df09 = load_morg(path09, 2009)

    print("\nStep 2: Restrict to MORG outgoing rotation groups")
    df08 = restrict_to_morg(df08)
    df09 = restrict_to_morg(df09)
    n_t = len(df08)

    print("\nStep 3: Create matched panel")
    naive = create_panel(df08, df09)
    print(f"Total naive matched pairs: {len(naive):,}")

    if naive.empty:
        sys.exit(
            "ERROR: No matches found. Check whether hhid/hhnum/lineno/intmonth/state "
            "are coded consistently across the two files."
        )

    print("\nStep 4: Apply SRA filter")
    valid, invalid = apply_sra_filter(naive)

    print("\nStep 5: Diagnostics")
    print_diagnostics(naive, valid, invalid, n_t)

    print(f"\nStep 6: Save valid matches to {out_path}")
    valid.to_csv(out_path, index=False)

    if args.keep_invalid:
        rejected_path = out_path.with_name(out_path.stem + "_rejected.csv")
        invalid.to_csv(rejected_path, index=False)
        print(f"Rejected matches saved to: {rejected_path}")

    print("\nDone.")


if __name__ == "__main__":
    main()